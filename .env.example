# ----------------------------------------
# Required Core Settings
# ----------------------------------------
# The PostgreSQL connection string using the asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diagnostics

# The secret string used to sign JWT Auth tokens (Keep this safe!)
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# The shared secret used to verify incoming webhook signatures
WEBHOOK_SIGNING_SECRET=change-this-to-a-secure-webhook-secret

# Redis cache connection URL 
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------
# Optional / Configurable Settings
# ----------------------------------------
# The algorithm used for JWTs (Defaults to HS256)
JWT_ALGORITHM=HS256

# How long until a user's login session expires (Defaults to 60 minutes)
JWT_EXPIRE_MINUTES=60

# Determines if detailed error tracing is printed or if simulated payments can be forced (Defaults to False)
DEBUG=False

# The simulated success rate of a payment between 0.0 and 1.0 (Defaults to 0.85 / 85%)
PAYMENT_SUCCESS_RATE=0.85
